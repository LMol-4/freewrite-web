NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key
APP_ORIGIN=http://127.0.0.1:3000
APP_ALLOWED_ORIGINS=http://localhost:3000

# Server-only MCP credentials. Never use NEXT_PUBLIC_ for these.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-service-role-key
# Generate 32 random bytes as 64 hexadecimal characters; keep stable across deployments.
MCP_KEY_ENCRYPTION_SECRET=replace-with-64-hex-characters
