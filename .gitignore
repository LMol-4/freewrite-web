# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# misc
.DS_Store
Thumbs.db
*.pem
*.swp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env — .env.example is committed, real keys are not
.env*
!.env.example

# supabase — config.toml and migrations/ ARE committed; only local stack state is ignored
supabase/.temp/
supabase/.branches/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# planning docs — local only, never committed
PLAN.md
PROGRESS.md

# Disposable loopback-only integration stack
/.local-test/
